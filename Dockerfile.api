# syntax=docker/dockerfile:1

# ==============================================================================
# Stage 1: Build stage (Monorepo Turborepo + Bun)
# ==============================================================================
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Install Bun binary from official image
COPY --from=oven/bun:1.4.2 /usr/local/bin/bun /usr/local/bin/bun

# Copy monorepo configuration and lockfile
COPY package.json bun.lock turbo.json tsconfig.base.json tsconfig.json blocks.json ./

# Copy package manifests for workspace resolution
COPY packages/api/package.json ./packages/api/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/vendor/package.json ./apps/vendor/package.json
COPY apps/storefront/package.json ./apps/storefront/package.json

# Install dependencies for the whole workspace
RUN bun install --frozen-lockfile

# Copy application sources needed for backend and dashboard bundling
COPY packages/api ./packages/api
COPY apps/admin ./apps/admin
COPY apps/vendor ./apps/vendor

# Panels require backend origin baked at build time when NODE_ENV=production
ARG MERCUR_BACKEND_URL="https://api.mercur.etsmtl.club"
ARG VITE_MERCUR_BACKEND_URL=""
ENV MERCUR_BACKEND_URL=${MERCUR_BACKEND_URL:-https://api.mercur.etsmtl.club}
ENV VITE_MERCUR_BACKEND_URL=${VITE_MERCUR_BACKEND_URL}
ENV NODE_ENV=production

# Build admin, vendor, and API (@acme/api build triggers panel bundling into .medusa/server)
RUN bun x turbo run build --filter=@acme/api...

# ==============================================================================
# Stage 2: Production Runner
# ==============================================================================
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=9000

# Install Bun binary for runtime and script execution
COPY --from=oven/bun:1.4.2 /usr/local/bin/bun /usr/local/bin/bun

# Create non-root system user with a home directory
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 -m -d /home/medusa -g nodejs medusa && \
    mkdir -p /home/medusa/.config && \
    chown -R medusa:nodejs /home/medusa

ENV HOME=/home/medusa

# Copy dependencies and monorepo files
COPY --from=builder --chown=medusa:nodejs /app/node_modules ./node_modules
COPY --from=builder --chown=medusa:nodejs /app/package.json ./package.json
COPY --from=builder --chown=medusa:nodejs /app/packages/api ./packages/api
COPY --from=builder --chown=medusa:nodejs /app/apps/admin/dist ./apps/admin/dist
COPY --from=builder --chown=medusa:nodejs /app/apps/vendor/dist ./apps/vendor/dist

USER medusa
WORKDIR /app/packages/api

EXPOSE 9000

# Default command: runs medusa start. Can be overridden in K8s (e.g. for migrations or worker)
CMD ["bun", "run", "start"]
