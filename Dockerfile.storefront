# syntax=docker/dockerfile:1

# ==============================================================================
# Stage 1: Build stage (Next.js Standalone Build)
# ==============================================================================
FROM node:22-bookworm-slim AS builder
WORKDIR /app

# Install Bun binary
COPY --from=oven/bun:1.4.2 /usr/local/bin/bun /usr/local/bin/bun

# Copy monorepo configuration and lockfile
COPY package.json bun.lock turbo.json tsconfig.base.json tsconfig.json blocks.json ./

# Copy package manifests for workspace resolution
COPY apps/storefront/package.json ./apps/storefront/package.json
COPY packages/api/package.json ./packages/api/package.json
COPY apps/admin/package.json ./apps/admin/package.json
COPY apps/vendor/package.json ./apps/vendor/package.json

# Install dependencies
RUN bun install --frozen-lockfile

# Copy storefront source and API type exports if referenced
COPY apps/storefront ./apps/storefront
COPY packages/api ./packages/api

# Build-time environment variables for Next.js public config
ARG NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=""
ARG MEDUSA_BACKEND_URL="http://localhost:9000"
ARG NEXT_PUBLIC_BASE_URL="http://localhost:3000"
ARG NEXT_PUBLIC_DEFAULT_REGION="ca"
ARG NEXT_PUBLIC_STRIPE_KEY=""
ARG NEXT_PUBLIC_VENDOR_URL="http://localhost:9000/seller"

ENV NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=${NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY}
ENV MEDUSA_BACKEND_URL=${MEDUSA_BACKEND_URL}
ENV NEXT_PUBLIC_BASE_URL=${NEXT_PUBLIC_BASE_URL}
ENV NEXT_PUBLIC_DEFAULT_REGION=${NEXT_PUBLIC_DEFAULT_REGION}
ENV NEXT_PUBLIC_STRIPE_KEY=${NEXT_PUBLIC_STRIPE_KEY}
ENV NEXT_PUBLIC_VENDOR_URL=${NEXT_PUBLIC_VENDOR_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_ENV=production

# Run Next.js build (produces .next/standalone)
WORKDIR /app/apps/storefront
RUN bun run build

# ==============================================================================
# Stage 2: Production Runner
# ==============================================================================
FROM node:22-bookworm-slim AS runner
WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000
ENV HOSTNAME="0.0.0.0"
ENV NEXT_TELEMETRY_DISABLED=1

# Create non-root system user with a home directory
RUN groupadd --system --gid 1001 nodejs && \
    useradd --system --uid 1001 -m -d /home/nextjs -g nodejs nextjs

ENV HOME=/home/nextjs

# Copy standalone output and static assets (monorepo paths preserved by Next.js standalone)
COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/.next/static ./apps/storefront/.next/static
COPY --from=builder --chown=nextjs:nodejs /app/apps/storefront/public ./apps/storefront/public

USER nextjs

EXPOSE 3000

CMD ["node", "apps/storefront/server.js"]
